{
  "name": "exp3",
  "model": {
    "d_model": 128,
    "n_layers": 4,
    "n_heads": 4,
    "d_ff": 512,
    "max_seq_len": 80,
    "dropout": 0.1
  },
  "train": {
    "batch_size": 64,
    "lr": 1e-3,
    "warmup_steps": 300,
    "min_lr": 1e-4,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "max_epochs": 50,
    "early_stopping_patience": 5,
    "seed": 42,
    "threads": 5
  }
}
